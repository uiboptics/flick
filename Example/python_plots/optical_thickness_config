/*
Aerosol vertical total optical thickness at 550 nm.
*/

aerosol_od = 0 

/*
Ratio of rural aerosol optical depth to total aerosol optical depth.
A value of ‘1’ corresponds to rural aerosols only, while a value of ‘0’
corresponds to urban aerosols only.
*/

aerosol_ratio = 1 

/*
Atmospheric constituent profile type. Valid options are
‘tropical’, ‘midlatitude_summer’, ‘midlatitude_winter’,
‘subarctic_summer’, ‘subarctic_winter’, and ‘us_standard’.
*/

atmosphere_type = us_standard 

/*
Name of the spectral albedo file to be used at bottom boundary. See
accurt_api/bottom_albedo. Current valid names are ´loamy_sand.txt´ and
´custom.txt´.
*/

bottom_albedo_file = loamy_sand.txt 

/*
Darkness scaling of the bottom boundary, where ‘0’ corresponds to no
bottom reflection and ‘1’ corresponds to the albedo given by data in
file given by the bottom_albedo_file.
*/

bottom_boundary_surface_scaling_factor = 1 

/*
Total depth of the water column [m].
*/

bottom_depth = 200 

/*
Select `full_mie` or `parameterized_mie` for calculation of water
bubble IOPs with a full Mie code or a fast parameterized Mie code
optimized for large spheres.
*/

bubble_calculator = parameterized_mie 

/*
Median radius of the log-normal size distribution [m]. This median
radius is exp(mu), where mu is the mean of the natural logarithm of the radius
distribution.
*/

bubble_radius = 1e-05 

/*
Size-distribution sigma. Sigma is the standard deviation of the
natural logarithm of the radius distribution.
*/

bubble_sigma = 0 

/*
Bubble volume fraction in water [unitless].
*/

bubble_volume_fraction = 0 

/*
CDOM absorption coefficient at 440 nm [1/m].
*/

cdom_440 = 0 

/*
Slope of the CDOM absorption spectrum 1/nm. Note that
this unit is an exception to the SI mks unit convention.
*/

cdom_slope = 0.017 

/*
Chlorophyll concentration in the water column [kg/m^3]. A
concentration of e.g., 10.0 mg/m^3 may be written as 10.0e-6 kg/m^3
for clarity.
*/

chl_concentration = 0 

/*
Liquid equivalent cloud thickness [m]. Typical values range from
0 to 1e-4 m.
*/

cloud_liquid = 0 

/*
Space-separated list of material names that is scaled by the factors
listed by the concentration_exception_scaling_factors. Spelling is
fine, but I would make the sentence a little clearer: Valid material
names are: cdom, phytoplankton, nap, bubbles, and any names listed by
the variables `ti_names`, `mp_names`, or `mcdom_names`. The latter
three must use the respective prefixes `ti_`, `mp_`, and `mcdom_`.
*/

concentration_exception_names =   

/*
Space-separated list of scaling factors that scale the concentration
of all ocean materials listed by the `concentration_exception_materials`
variable.
*/

concentration_exception_scaling_factors = 1 1 

/*
Space-separated list of depth fractions (df), ranging from the surface
(df = 0) to the bottom (df = 1), defining depths of the material
scaling factor profile. See the `concentration_scaling_factors`
variable.
*/

concentration_relative_depths = 0 1 

/*
Space-separated list of scaling factors that scale the concentration
of all ocean materials except pure water, sea ice with brines and
bubbles, and those listed by the concentration_exception_names
variable.
*/

concentration_scaling_factors = 1 1 

/*
Detector height relative to sea level [m]. A positive value
corresponds to a height in the atmosphere, and a negative value
corresponds to a depth in the ocean.
*/

detector_height = 120000 

/*
Detector vertical orientation, either ‘up’ or ‘down’.
*/

detector_orientation = down 

/*
Polar and azimuth viewing angles for overriding the default slant
radiance view [degrees].

Setting the angles to '0 0' disables the override. In this case, the
radiance detector is oriented vertically upward when
detector_orientation = ‘up’, and vertically downward when
detector_orientation = ‘down’.

For nonzero override angles:
- Polar angles < 90 degrees correspond to viewing directions in the
  upper hemisphere.
- An azimuth angle of 0 degrees corresponds to the azimuth direction
  of the source.
- Positive and negative azimuth angles correspond to directions west
  and east of the sun, respectively.
*/

detector_orientation_override = 0 0 

/*
Number of polar and azimuth viewing angles used to override the default
settings for detection of angularly distributed radiance.

Setting the values to '0 0' disables the override. In this case, the
radiance detector is oriented vertically upward when
detector_orientation = ‘up’, and vertically downward when
detector_orientation = ‘down’.

For nonzero override values, the first number specifies the number of
polar viewing angles, linearly spaced from 0 to 180 degrees, and the
second number specifies the number of azimuth viewing angles, linearly
spaced from -180 to 180 degrees.

If detector_radiance_distribution_override is enabled, Flick returns a
3D array containing radiance values for each wavelength, polar angle,
and azimuth angle, respectively.
*/

detector_radiance_distribution_override = 0 0 

/*
Type of radiation to be detected. Valid options are
‘plane_irradiance’, ‘scalar_irradiance’, and ‘radiance’.
*/

detector_type = radiance 

/*
Space-separated list of radiation wavelengths [m] to be calculated and
saved.  Note that a wavelength (e.g., 400 nm) may be written as 400e-9
m for clarity.
*/

detector_wavelengths = 4e-07 5e-07 

/*
Specifies the directory where the Flick and AccuRT configuration files,
as well as the AccuRT material and output subdirectories, are stored.
*/

flick_tmp_directory_name = flick_tmp 

/*
Atmospheric spectral region for pre-calculated, smoothed gas
absorption spectra. Valid options are ‘uv_vis’, ‘uv_vis_toa’, and
´solar´.  ‘uv_vis’ option is optimized for bottom-of-atmosphere
calculations in the 280-1030 nm region with line-by-line IOPs smoothed
to about 0.5 nm bandwidth; ‘uv_vis_toa’ option is optimized for
top-of-atmosphere calculations in the 280-1030 nm region with
line-by-line IOPs smoothed to 0.5 nm bandwidth; ‘solar’ option is
optimized for bottom-of-atmosphere calculations in the 280-2500 nm
region with line-by-line IOPs smoothed to 3 nm bandwidth at 300 nm.
All band widths are progressively slightly increasing with wavelength
*/

gas_spectral_region = uv_vis 

